---
import InlineCode from './InlineCode.astro';

interface Props {
  title: string;
  badgeSrc?: string | string[];
  commands: {
    command: string | string[];
    description: string;
  }[];
  footnote?: string;
}

const { title, badgeSrc, commands, footnote } = Astro.props;

const formattedCommands = commands.map(({ command, ...rest }) => ({
  command: typeof command === 'string' ? [command] : command,
  ...rest,
}));

const badgeSrcList = typeof badgeSrc === 'string' ? [badgeSrc] : badgeSrc;
---

<section class="p-2 text-lg bg-white shadow-md rounded-lg">
  <div class="mb-3 flex items-center gap-2">
    {
      badgeSrcList?.map(
        (src) => src && <img aria-hidden="true" alt="" height="28px" width="28px" src={src} />
      )
    }
    <h2 class="font-bold text-2xl">{title}</h2>
  </div>
  <ul class="my-3">
    {
      formattedCommands.map(({ command, description }) => (
        <li class="my-2.5">
          {[
            command.map((c) => <InlineCode class="mr-1">!{c}</InlineCode>),
            <span class="mr-1 select-none">-</span>,
            <span>{description}</span>,
          ]}
        </li>
      ))
    }
  </ul>
  {footnote && <p class="text-end text-sm">* {footnote}</p>}
</section>
