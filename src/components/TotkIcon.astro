---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { typeStyle } from '../lib/totkBounties';

interface Props {
  type: string;
  size?: number;
}

const { type, size = 20 } = Astro.props;
const { icon, color, image, invert } = typeStyle(type);
---

<span
  class="inline-flex shrink-0 items-center justify-center"
  style={{ width: `${size}px`, height: `${size}px`, color }}
  aria-hidden="true"
>
  {image ? (
    <img
      src={image}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class:list={[invert && 'invert']}
    />
  ) : (
    <FontAwesomeIcon icon={icon} height={`${size}px`} width={`${size}px`} />
  )}
</span>
