---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { typeStyle } from '../lib/totkBounties';

interface Props {
  type: string;
  size?: number;
}

const { type, size = 20 } = Astro.props;
const { icon, image } = typeStyle(type);
const inner = Math.round(size * 0.8);
---

<span
  class="inline-flex shrink-0 items-center justify-center rounded-md bg-slate-800"
  style={{ width: `${size}px`, height: `${size}px` }}
  aria-hidden="true"
>
  {image ? (
    <img src={image} alt="" width={inner} height={inner} loading="lazy" decoding="async" />
  ) : (
    <FontAwesomeIcon
      icon={icon}
      height={`${inner}px`}
      width={`${inner}px`}
      className="text-white"
    />
  )}
</span>
