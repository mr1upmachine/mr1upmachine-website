---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NightBackground from '../../components/NightBackground.astro';
import { MOD_COMMANDS } from '../../consts';
import InlineCode from '../../components/InlineCode.astro';
---

<!doctype html>
<html class="h-full" lang="en">
  <head>
    <BaseHead />
  </head>
  <body class="h-full">
    <NightBackground />
    <Header />
    <main class="px-2 sm:px-8 py-6 flex justify-center">
      <section class="flex flex-col gap-6 text-[#364153] basis-[70ch] max-w-[70ch]">
        <section class="p-2 text-lg bg-white shadow-md rounded-lg">
          <h2 class="font-bold text-2xl mb-3">Moderator only</h2>
          <ul class="my-3">
            {
              MOD_COMMANDS.map(({ command, description }) => (
                <li class="my-2">
                  <InlineCode>!{command}</InlineCode>
                  <span class="select-none"> - </span>
                  <span>{description}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </section>
    </main>
    <Footer className="fixed bottom-0 left-0 right-0" />
  </body>
</html>
