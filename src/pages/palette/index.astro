---
import SiteBase from '../../components/SiteBase.astro';
---

<SiteBase>
  <div class="flex w-full max-w-[1100px] flex-col gap-3">
    <header class="card py-4">
      <h3 class="text-2xl font-bold">Palette editor</h3>
    </header>

    <div class="aspect-video overflow-hidden rounded-lg border border-neutral-700 bg-black">
      <canvas
        id="tiles"
        width="2560"
        height="1440"
        aria-label="Palette preview"
        class="block h-full w-full"
      ></canvas>
    </div>

    <section
      id="panel"
      class="flex flex-col gap-3 rounded-lg border border-neutral-700 bg-neutral-900 p-3 text-neutral-100"
      aria-label="Palette settings"
    >
      <div class="flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-xs leading-4 text-neutral-400">
          Tile size
          <input
            id="size"
            type="number"
            step="1"
            inputmode="numeric"
            class="h-[34px] w-[90px] rounded border border-neutral-600 bg-neutral-800 px-2 font-mono text-[13px] text-white"
          />
        </label>
        <label class="flex flex-col gap-1 text-xs leading-4 text-neutral-400">
          Speed
          <input
            id="speed"
            type="number"
            step="any"
            inputmode="decimal"
            class="h-[34px] w-[90px] rounded border border-neutral-600 bg-neutral-800 px-2 font-mono text-[13px] text-white"
          />
        </label>
        <div class="ml-auto flex flex-wrap gap-3">
          <button
            id="copy-command"
            type="button"
            class="h-[34px] cursor-pointer rounded border border-neutral-600 bg-neutral-700 px-3 text-[13px] text-white enabled:hover:bg-neutral-600"
          >
            Copy !setpalette
          </button>
          <button
            id="copy-redeem"
            type="button"
            class="h-[34px] cursor-pointer rounded border border-neutral-600 bg-neutral-700 px-3 text-[13px] text-white enabled:hover:bg-neutral-600"
          >
            Copy for redeem
          </button>
        </div>
        <div class="flex w-full min-w-0 flex-col gap-1 text-xs leading-4 text-neutral-400">
          <span id="colors-label">Colors</span>
          <div
            id="colors"
            role="group"
            aria-labelledby="colors-label"
            class="relative flex flex-wrap gap-3"
          ></div>
        </div>
      </div>
      <p
        id="status"
        aria-live="polite"
        class="min-h-[16px] self-end font-mono text-xs leading-4 text-neutral-400"
      ></p>
    </section>
  </div>

  <script is:inline>
    (() => {
      // ---- Constants (match the stream overlay page) ----
      const REF_W = 2560;
      const REF_H = 1440;
      const MIN_SIZE = 16;
      const MAX_SIZE = 1440;
      const MIN_COLORS = 2;
      const MIN_SPEED = 0.05;
      const MAX_SPEED = 100;
      const BASE_CYCLE_SECONDS = 90; // one full color cycle at speed 1
      const FPS = 30;
      const DEFAULT_SIZE = 52;
      const DEFAULT_SPEED = 1;
      const DEFAULT_COLORS = ['ff5e5b', 'ffb400', '3a0ca3'];

      // Tailwind classes for the elements built in JS. Keep them as full class names
      // in this file so Tailwind's scanner can see them.
      const BTN_BASE =
        'h-[34px] cursor-pointer rounded border border-neutral-600 bg-neutral-700 text-[13px] text-white enabled:hover:bg-neutral-600 disabled:cursor-default disabled:opacity-40';
      const BTN = BTN_BASE + ' px-3';
      const BTN_REMOVE = BTN_BASE + ' w-[34px] p-0';
      const HEX_INPUT =
        'h-[34px] w-20 rounded border bg-neutral-800 px-2 font-mono text-[13px] text-white';
      const BORDER_OK = 'border-neutral-600';
      const BORDER_BAD = 'border-red-500';
      const COLOR_INPUT =
        'h-[34px] w-[34px] cursor-pointer appearance-none overflow-hidden rounded border border-neutral-600 bg-neutral-800 p-0 [&::-moz-color-swatch]:border-0 [&::-webkit-color-swatch]:rounded-none [&::-webkit-color-swatch]:border-0 [&::-webkit-color-swatch-wrapper]:p-0';
      const HANDLE =
        'drag-handle flex h-[34px] w-4 touch-none select-none items-center justify-center text-base text-neutral-500 hover:text-neutral-300';
      const DRAGGING_ITEM = ['relative', 'z-20', 'opacity-80', 'drop-shadow-lg'];

      const $ = (id) => document.getElementById(id);

      // ---- Parsing helpers ----
      const cleanHex = (c) => c.trim().replace(/^#/, '').toLowerCase();
      // Accepts "f80" as well as "ff8800"
      const normalizeHex = (c) => {
        const h = cleanHex(c);
        return /^[0-9a-f]{3}$/.test(h) ? h.replace(/./g, (m) => m + m) : h;
      };
      const isHex = (c) => /^[0-9a-f]{6}$/.test(c);
      const clampSize = (v, fallback) =>
        isNaN(v) ? fallback : Math.min(MAX_SIZE, Math.max(MIN_SIZE, Math.round(v)));
      // Negative runs backwards, 0 is static; keeps the sign and clamps the size
      const clampSpeed = (v, fallback) =>
        isNaN(v)
          ? fallback
          : v === 0
            ? 0
            : Math.sign(v) * Math.min(MAX_SPEED, Math.max(MIN_SPEED, Math.abs(v)));

      // ---- State (initialised from the URL so a palette can be shared as a link) ----
      const params = new URLSearchParams(window.location.search);
      const state = {
        size: clampSize(parseFloat(params.get('size')), DEFAULT_SIZE),
        speed: clampSpeed(parseFloat(params.get('speed')), DEFAULT_SPEED),
        colors: DEFAULT_COLORS.slice(),
      };
      const fromUrl = (params.get('colors') || '').split(',').map(normalizeHex).filter(isHex);
      if (fromUrl.length >= MIN_COLORS) state.colors = fromUrl;

      const syncUrl = () => {
        const p = new URLSearchParams(window.location.search);
        p.set('colors', state.colors.join(','));
        p.set('size', String(state.size));
        p.set('speed', String(state.speed));
        const query = p.toString().replace(/%2C/gi, ',');
        history.replaceState(null, '', location.pathname + '?' + query + location.hash);
      };

      // ---- Rendering ----
      // The canvas is always 2560x1440 (the stream's reference size) and scaled down by CSS,
      // so the preview has exactly the same grid, cropping and proportions as on stream.
      const canvas = $('tiles');
      const ctx = canvas.getContext('2d', { alpha: false });
      let rgb = [];
      let phase = 0; // 0..1 through one full color cycle

      const applyColors = () => {
        rgb = state.colors.map((c) => [
          parseInt(c.slice(0, 2), 16),
          parseInt(c.slice(2, 4), 16),
          parseInt(c.slice(4, 6), 16),
        ]);
      };

      // Linear blend between neighbouring colors, color i at i/n, wrapping to the first
      const colorAt = (p) => {
        const n = rgb.length;
        const pos = (((p % 1) + 1) % 1) * n;
        const i = Math.floor(pos);
        const f = pos - i;
        const a = rgb[i % n];
        const b = rgb[(i + 1) % n];
        const ch = (k) => Math.round(a[k] + (b[k] - a[k]) * f);
        return 'rgb(' + ch(0) + ',' + ch(1) + ',' + ch(2) + ')';
      };

      const geometry = () => {
        const size = state.size;
        const columns = Math.ceil(REF_W / size);
        const rows = Math.ceil(REF_H / size);
        const cropX = columns * size - REF_W;
        const cropY = rows * size - REF_H;
        return { size, columns, rows, cropX, cropY, span: Math.max(1, columns + rows - 2) };
      };

      const draw = () => {
        const g = geometry();
        const offX = -Math.floor(g.cropX / 2);
        const offY = -Math.floor(g.cropY / 2);
        // Tiles on the same diagonal share a color, so set fillStyle once per diagonal
        for (let d = 0; d <= g.span; d++) {
          ctx.fillStyle = colorAt(phase + d / g.span);
          const i0 = Math.max(0, d - (g.columns - 1));
          const i1 = Math.min(g.rows - 1, d);
          for (let i = i0; i <= i1; i++) {
            const j = i + g.columns - 1 - d;
            ctx.fillRect(offX + j * g.size, offY + i * g.size, g.size, g.size);
          }
        }
      };

      const statusEl = $('status');
      const renderStatus = () => {
        const g = geometry();
        statusEl.textContent =
          g.columns +
          'x' +
          g.rows +
          ' tiles, ' +
          (g.cropX || g.cropY ? g.cropX + 'px x, ' + g.cropY + 'px y cropped' : 'exact fit');
      };

      // Advance the color cycle. Phase accumulates, so changing speed never jumps.
      let lastFrame = performance.now();
      const loop = (now) => {
        requestAnimationFrame(loop);
        if (state.speed === 0) {
          lastFrame = now; // static: nothing to animate
          return;
        }
        const dt = now - lastFrame;
        if (dt < 1000 / FPS - 2) return;
        lastFrame = now;
        phase = (((phase + (dt / 1000) * (state.speed / BASE_CYCLE_SECONDS)) % 1) + 1) % 1;
        draw();
      };

      // ---- Copy text ----
      // Args: <hex> <hex> ... size=<n> speed=<n>   (hex without '#')
      const argsText = () =>
        state.colors.join(' ') + ' size=' + state.size + ' speed=' + state.speed;
      const commandText = () => '!setpalette ' + argsText();

      const copyText = async (text) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (e) {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          let ok = false;
          try {
            ok = document.execCommand('copy');
          } catch (err) {}
          ta.remove();
          return ok;
        }
      };

      const wireCopyButton = (btn, getText) => {
        const label = btn.textContent;
        btn.addEventListener('click', async () => {
          const text = getText();
          const ok = await copyText(text);
          btn.title = text;
          btn.textContent = ok ? 'Copied!' : 'Copy failed';
          setTimeout(() => (btn.textContent = label), 1500);
        });
        btn.addEventListener('mouseenter', () => (btn.title = getText()));
      };

      // ---- Editor ----
      const sizeInput = $('size');
      const speedInput = $('speed');
      const colorsWrap = $('colors');

      const commit = (opts) => {
        syncUrl();
        applyColors();
        draw(); // needed when static, harmless otherwise
        renderStatus();
        if (opts && opts.rerender) renderColorInputs();
      };

      sizeInput.addEventListener('change', () => {
        state.size = clampSize(parseFloat(sizeInput.value), state.size);
        sizeInput.value = state.size;
        commit();
      });
      speedInput.addEventListener('change', () => {
        state.speed = clampSpeed(parseFloat(speedInput.value), state.speed);
        speedInput.value = state.speed;
        commit();
      });
      // Enter commits the same way blur does
      $('panel').addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && e.target.tagName === 'INPUT') e.target.blur();
      });

      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = BTN;
      addBtn.textContent = '+ Color';
      addBtn.addEventListener('click', () => {
        state.colors.push(state.colors[state.colors.length - 1]);
        commit({ rerender: true });
      });

      // Reorder by dragging the grip. Pointer events cover mouse, touch and pen.
      const attachDrag = (handle, item, fromIdx) => {
        handle.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          e.preventDefault();
          handle.setPointerCapture(e.pointerId);
          const startX = e.clientX;
          const startY = e.clientY;
          item.classList.add(...DRAGGING_ITEM);
          handle.classList.replace('cursor-grab', 'cursor-grabbing');

          const others = [...colorsWrap.querySelectorAll('.color-item')].filter(
            (el) => el !== item
          );
          const rects = others.map((el) => el.getBoundingClientRect());
          const wrapRect = colorsWrap.getBoundingClientRect();
          const gap = parseFloat(getComputedStyle(colorsWrap).columnGap) || 0;
          const line = document.createElement('div');
          line.className = 'pointer-events-none absolute w-[3px] rounded-sm bg-sky-400';
          line.hidden = true;
          colorsWrap.appendChild(line);
          let toIdx = null;

          const onMove = (ev) => {
            item.style.transform =
              'translate(' + (ev.clientX - startX) + 'px, ' + (ev.clientY - startY) + 'px)';
            // Nearest other item, weighting vertical distance so the same row wins
            let best = -1;
            let bestD = Infinity;
            rects.forEach((r, k) => {
              const cx = r.left + r.width / 2;
              const cy = r.top + r.height / 2;
              const d = Math.hypot(ev.clientX - cx, (ev.clientY - cy) * 3);
              if (d < bestD) {
                bestD = d;
                best = k;
              }
            });
            if (best < 0) return;
            const r = rects[best];
            const after = ev.clientX > r.left + r.width / 2;
            const targetIdx = best < fromIdx ? best : best + 1;
            let idx = targetIdx + (after ? 1 : 0);
            if (idx > fromIdx) idx -= 1; // account for removing the dragged item first
            if (idx === fromIdx) {
              toIdx = null;
              line.hidden = true;
              return;
            }
            toIdx = idx;
            line.hidden = false;
            line.style.left =
              (after ? r.right + gap / 2 : r.left - gap / 2) - wrapRect.left - 1.5 + 'px';
            line.style.top = r.top - wrapRect.top + 'px';
            line.style.height = r.height + 'px';
          };

          const finish = (cancelled) => {
            handle.removeEventListener('pointermove', onMove);
            handle.removeEventListener('pointerup', onUp);
            handle.removeEventListener('pointercancel', onCancel);
            item.classList.remove(...DRAGGING_ITEM);
            handle.classList.replace('cursor-grabbing', 'cursor-grab');
            item.style.transform = '';
            line.remove();
            if (!cancelled && toIdx !== null) {
              const moved = state.colors.splice(fromIdx, 1)[0];
              state.colors.splice(toIdx, 0, moved);
              commit({ rerender: true });
            }
          };
          const onUp = () => finish(false);
          const onCancel = () => finish(true);
          handle.addEventListener('pointermove', onMove);
          handle.addEventListener('pointerup', onUp);
          handle.addEventListener('pointercancel', onCancel);
        });
      };

      function renderColorInputs() {
        colorsWrap.replaceChildren();
        state.colors.forEach((hex, i) => {
          const item = document.createElement('div');
          item.className = 'color-item flex items-center gap-1';

          const handle = document.createElement('span');
          handle.className = HANDLE + ' cursor-grab';
          handle.textContent = '⠿';
          handle.title = 'Drag to reorder';
          attachDrag(handle, item, i);

          const picker = document.createElement('input');
          picker.type = 'color';
          picker.className = COLOR_INPUT;
          picker.value = '#' + hex;
          picker.setAttribute('aria-label', 'Color ' + (i + 1));

          const text = document.createElement('input');
          text.type = 'text';
          text.className = HEX_INPUT + ' ' + BORDER_OK;
          text.value = hex;
          text.maxLength = 7;
          text.spellcheck = false;
          text.setAttribute('aria-label', 'Color ' + (i + 1) + ' hex');

          const setColor = (raw) => {
            const c = normalizeHex(raw);
            if (!isHex(c)) {
              text.classList.replace(BORDER_OK, BORDER_BAD);
              text.value = state.colors[i];
              setTimeout(() => text.classList.replace(BORDER_BAD, BORDER_OK), 600);
              return;
            }
            state.colors[i] = c;
            picker.value = '#' + c;
            text.value = c;
            commit();
          };
          // The color picker fires "change" when it closes; the text field on blur
          picker.addEventListener('change', () => setColor(picker.value));
          text.addEventListener('change', () => setColor(text.value));

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = BTN_REMOVE;
          remove.textContent = '×';
          remove.setAttribute('aria-label', 'Remove color ' + (i + 1));
          remove.disabled = state.colors.length <= MIN_COLORS;
          remove.addEventListener('click', () => {
            state.colors.splice(i, 1);
            commit({ rerender: true });
          });

          item.append(handle, picker, text, remove);
          colorsWrap.appendChild(item);
        });
        colorsWrap.appendChild(addBtn); // sits inline after the last color
      }

      // ---- Init ----
      wireCopyButton($('copy-command'), commandText);
      wireCopyButton($('copy-redeem'), argsText);
      sizeInput.value = state.size;
      speedInput.value = state.speed;
      renderColorInputs();
      applyColors();
      draw();
      renderStatus();
      requestAnimationFrame(loop);
    })();
  </script>
</SiteBase>
